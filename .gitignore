# IDE / Editor
.claude/
.gemini/
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
ENV/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Project Specific (Temporary/Build)
build/
dist/
scratch/
brain/
saves/
*.bak
*.tmp
*.log

# Backup timestampati dei cataloghi/taxonomy (rigenerabili; il bare *.bak non li copre)
*.bak.*
*_backup_*.json

# Autosave dell'editor (file temporanei, non vanno versionati)
*.autosave

# Cache binarie rigenerabili dell'editor (scatter / palette background)
engine/data/*.db

# Safe delete: cestino locale + audit log delle operazioni distruttive
.editor_trash/
.editor_audit.log
# saves/ # Decommenta se vuoi ignorare i salvataggi locali

# Web export — output dei build web (pesanti, rigenerabili con editor.web_exporter)
build_web/

# Web platform — dati locali (NON committare: credenziali, giochi caricati, catalogo)
web_platform/games/
web_platform/config.json
web_platform/catalog.json

# Android build artifacts (gli APK sotto build/ sono gia' ignorati; questi per sicurezza)
.buildozer/
*.apk
*.aab
*.keystore
*.keystore.jks

# Editor cache (rigenerabile)
.editor_cache/

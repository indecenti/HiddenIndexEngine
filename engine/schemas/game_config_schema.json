{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "game_config.json",
  "type": "object",
  "required": ["game_id", "version", "title_key", "menu"],
  "additionalProperties": true,
  "properties": {
    "id":               { "type": "string" },
    "game_id":          { "type": "string", "minLength": 1 },
    "version":          { "type": "string" },
    "title_key":        { "type": "string" },
    "default_language": { "type": "string", "minLength": 2 },
    "fallback_language":{ "type": "string" },
    "ui_theme":         { "type": "string" },
    "category":         { "type": "string" },
    "icon":             { "type": "string" },
    "levels":           { "type": "array", "items": { "type": "string" } },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "logo":             { "type": "string" },
        "icon":             { "type": "string" },
        "splash_background":{ "type": "string" }
      }
    },
    "menu": {
      "type": "object",
      "required": ["background"],
      "additionalProperties": true,
      "properties": {
        "background":             { "type": "string" },
        "background_static":      { "type": "string" },
        "level_select_background":{ "type": "string" },
        "music": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    },
    "hud": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "frame":        { "type": "string" },
        "font":         { "type": "string" },
        "text_color":   { "type": "array", "items": { "type": "integer" }, "minItems": 3, "maxItems": 4 },
        "accent_color": { "type": "array", "items": { "type": "integer" }, "minItems": 3, "maxItems": 4 },
        "position":     { "type": "string", "enum": ["bottom", "top"] }
      }
    },
    "hint_earn_config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "hints_per_scene": { "type": "integer", "minimum": 0 }
      }
    },
    "layer_hint_intensity": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0.0 }
    },
    "custom_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "z_value"],
        "additionalProperties": true,
        "properties": {
          "id":            { "type": "string" },
          "z_value":       { "type": "integer" },
          "label":         { "type": "string" },
          "hint_intensity":{ "type": "number", "minimum": 0.0 }
        }
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name_key", "condition"],
        "additionalProperties": true,
        "properties": {
          "id":              { "type": "string" },
          "name_key":        { "type": "string" },
          "description_key": { "type": "string" },
          "icon":            { "type": "string" },
          "condition":       { "type": "string" },
          "params":          { "type": "object" }
        }
      }
    }
  }
}

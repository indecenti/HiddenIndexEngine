{
  "id": "kids",
  "display_name": "Playground",
  "category": "desktop",

  "colors": {
    "background_overlay":   [ 70, 150, 200, 150],
    "btn_normal":           [255, 255, 255,   0],
    "btn_hover":            [255, 255, 255,   0],
    "btn_locked":           [200, 210, 215,   0],
    "btn_border_normal":    [255, 255, 255, 120],
    "btn_border_hover":     [255, 235, 120, 255],
    "btn_border_locked":    [180, 190, 195, 120],
    "text_normal":          [ 40,  55,  70],
    "text_hover":           [ 30,  40,  55],
    "text_locked":          [140, 150, 155],
    "icon_color":           [255, 250, 235],
    "slider_bg":            [120, 150, 170],
    "slider_fill":          [255, 205,  80],
    "slider_handle":        [255, 255, 255],
    "scene_border_normal":  [255, 255, 255, 120],
    "scene_border_hover":   [255, 235, 120, 255],
    "scene_overlay_hover":  [ 80, 120, 150, 110],
    "scene_overlay_normal": [ 60, 100, 130,  80],
    "lock_text":            [220, 110, 110],
    "btn_glow_color":       [255, 225, 120]
  },

  "layout": {
    "btn_border_radius":    28,
    "btn_width":            160,
    "btn_height":           160,
    "btn_center_x":         640,
    "btn_y_start":          200,
    "btn_y_step":           190,
    "btn_border_width":     0,
    "icons_only":           true,
    "icon_btn_size":        150,
    "no_btn_bg":            true,
    "slider_height":        28,
    "scene_grid_cols":      3,
    "scene_thumb_w":        320,
    "scene_thumb_h":        180,
    "title_font_size":      46,
    "title_y_offset":       100
  },

  "font": {
    "family":               null,
    "size_btn":             32,
    "size_label":           20,
    "size_scene":           22,
    "size_lock":            38,
    "bold":                 true
  },

  "effects": {
    "btn_shadow":           true,
    "btn_shadow_offset":    [3, 4],
    "btn_shadow_color":     [40, 80, 120, 120],
    "btn_glow":             true,
    "btn_glow_radius":      10,
    "text_shadow":          true,
    "text_shadow_offset":   [1, 2],
    "text_shadow_color":    [255, 255, 255, 120],
    "pulse_hover":          true,
    "pulse_scale":          1.06
  },

  "layout_profile": { "type": "carousel", "tilt": true },

  "motion": {
    "carousel_zoom":   0.30,
    "float_amp":       6.0,
    "magnetic":        true,
    "bounce":          true,
    "hover":           { "scale": 1.08, "speed": 9.0 },
    "reduced_motion":  { "disable": ["bounce", "float", "confetti", "particles"] }
  },

  "background": { "mode": "sky", "sky_top": [98, 192, 246], "sky_bottom": [116, 207, 154], "sun": true, "sun_color": [255, 215, 68] },

  "particles": { "type": "confetti", "density": 22, "color": [255, 122, 162] },

  "typography": {
    "display": { "family": ["Bubblegum Sans", "Comic Sans MS", "sans-serif"], "file": "fonts/BubblegumSans-Regular.ttf", "bold": true, "spacing": 1 },
    "title":   { "family": ["Bubblegum Sans", "Comic Sans MS", "sans-serif"], "file": "fonts/BubblegumSans-Regular.ttf", "bold": true },
    "body":    { "family": ["Bubblegum Sans", "Comic Sans MS", "sans-serif"], "file": "fonts/BubblegumSans-Regular.ttf", "bold": true }
  },

  "decor": { "card_radius": 24, "card_border": [255, 255, 255], "toy_shadow": [42, 126, 192], "confetti": true },

  "audio_feel": { "hover": "hover", "click": "click" }
}

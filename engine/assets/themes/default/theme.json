{
  "id": "default",
  "display_name": "Clean",
  "category": "desktop",

  "colors": {
    "background_overlay":   [ 12,  14,  20, 225],
    "btn_normal":           [ 40,  44,  54, 160],
    "btn_hover":            [ 70,  78,  95, 255],
    "btn_locked":           [ 30,  32,  38],
    "btn_border_normal":    [255, 255, 255,  30],
    "btn_border_hover":     [255, 255, 255, 140],
    "btn_border_locked":    [ 60,  60,  68],
    "text_normal":          [235, 238, 245],
    "text_hover":           [255, 255, 255],
    "text_locked":          [110, 112, 120],
    "icon_color":           [232, 236, 244],
    "slider_bg":            [ 30,  33,  40],
    "slider_fill":          [ 90, 150, 235],
    "slider_handle":        [255, 255, 255],
    "scene_border_normal":  [255, 255, 255,  45],
    "scene_border_hover":   [110, 160, 240, 255],
    "scene_overlay_hover":  [  0,   0,   0, 120],
    "scene_overlay_normal": [  0,   0,   0,  55],
    "lock_text":            [255,  90,  90],
    "btn_glow_color":       [120, 160, 240]
  },

  "layout": {
    "btn_border_radius":    16,
    "btn_width":            360,
    "btn_height":           64,
    "btn_center_x":         640,
    "btn_y_start":          470,
    "btn_y_step":           90,
    "btn_border_width":     0,
    "icons_only":           true,
    "icon_btn_size":        150,
    "no_btn_bg":            true,
    "slider_height":        24,
    "scene_grid_cols":      3,
    "scene_thumb_w":        320,
    "scene_thumb_h":        180,
    "title_font_size":      44,
    "title_y_offset":       110
  },

  "font": {
    "family":               null,
    "size_btn":             30,
    "size_label":           22,
    "size_scene":           24,
    "size_lock":            40,
    "bold":                 true
  },

  "effects": {
    "glass_effect":         true,
    "glass_color":          [255, 255, 255,  16],
    "glass_hover":          [255, 255, 255,  38],
    "btn_shadow":           true,
    "btn_shadow_offset":    [0, 3],
    "btn_shadow_color":     [0, 0, 0, 70],
    "btn_glow":             true,
    "btn_glow_radius":      10,
    "text_shadow":          true,
    "text_shadow_offset":   [0, 1],
    "text_shadow_color":    [0, 0, 0, 120],
    "pulse_hover":          true,
    "pulse_scale":          1.03
  },

  "layout_profile": { "type": "carousel" },

  "motion": {
    "carousel_zoom":   0.25,
    "float_amp":       4.0,
    "magnetic":        true,
    "enter":           { "type": "fade", "dur": 0.4, "ease": "ease_out" },
    "hover":           { "scale": 1.03, "speed": 8.0 },
    "reduced_motion":  { "disable": ["float", "particles", "aurora"] }
  },

  "background": { "mode": "image", "aurora": true, "aurora_color": [96, 166, 240] },

  "particles": { "type": "fireflies", "density": 7, "color": [188, 212, 245] },

  "typography": {
    "display": { "family": ["Marcellus", "Georgia", "serif"], "file": "fonts/Marcellus-Regular.ttf", "bold": false, "spacing": 1 },
    "title":   { "family": ["Marcellus", "Georgia", "serif"], "file": "fonts/Marcellus-Regular.ttf", "bold": false },
    "body":    { "family": ["Segoe UI", "Arial", "sans-serif"], "bold": true }
  },

  "decor": { "vignette": 0.0, "grain": 0.0, "icon_chip": true },

  "audio_feel": { "hover": "hover", "click": "click", "transition": "whoosh" },

  "views": {
    "main": {
      "buttons": [
        {"text_key": "btn_play", "action": "goto_levels", "tip_key": "tip_play"},
        {"text_key": "btn_settings", "action": "goto_settings", "tip_key": "tip_settings"},
        {"text_key": "btn_quit", "action": "quit", "is_quit": true}
      ]
    },
    "pause": {
      "buttons": [
        {"text_key": "btn_resume", "action": "resume_game"},
        {"text_key": "btn_settings", "action": "goto_settings"},
        {"text_key": "btn_quit_to_main", "action": "quit_to_main"}
      ]
    }
  }
}
